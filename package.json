{
  "name": "spanish-cities-info",
  "version": "2.4.0",
  "description": "8,132 Spanish municipalities verified against official INE data. Search by name, province, INE code, or radius (km). Modular imports by province/community. Postal codes available as an optional separate import. TypeScript, ~330KB (gzip: 125KB) for the main import.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provincias/*": {
      "types": "./dist/provincias/*.d.ts",
      "default": "./dist/provincias/*.js"
    },
    "./comunidades/*": {
      "types": "./dist/comunidades/*.d.ts",
      "default": "./dist/comunidades/*.js"
    },
    "./postal-codes": {
      "types": "./dist/postalCodes.d.ts",
      "default": "./dist/postalCodes.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prebuild": "node scripts/generate-modules.js",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManuelCebreiro/spanish-cities-info.git"
  },
  "keywords": [
    "spain",
    "spanish-cities",
    "cities",
    "provinces",
    "municipios",
    "geolocation",
    "typescript"
  ],
  "author": "Manuel Cebreiro",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ManuelCebreiro/spanish-cities-info/issues"
  },
  "homepage": "https://spanish-cities-info-web.vercel.app",
  "devDependencies": {
    "@types/node": "^20.14.1",
    "typescript": "^5.4.5"
  }
}
